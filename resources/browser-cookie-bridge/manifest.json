{
  "manifest_version": 3,
  "name": "砚 · 登录态导入 / Inkstone Cookie Bridge",
  "version": "1.0.1",
  "minimum_chrome_version": "130",
  "description": "仅在你点击确认后，通过本机桥接把选定网站的登录 Cookie 导入砚。",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["import.html"], "matches": ["http://127.0.0.1/*"] }],
  "action": { "default_title": "导入登录态到砚" },
  "background": { "service_worker": "background.js" }
}
