{
  "manifest_version": 3,
  "name": "砚 · 浏览器连接 / Inkstone Browser Bridge",
  "version": "1.1.3",
  "minimum_chrome_version": "130",
  "description": "把登录态导入砚，并在你于砚中批准后，让砚在这个浏览器里替你操作网页。",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "scripting", "tabs", "webNavigation", "alarms", "tabGroups", "storage"],
  "optional_permissions": ["debugger"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["import.html"], "matches": ["http://127.0.0.1/*"] }],
  "action": { "default_title": "砚 · 浏览器连接" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "background": { "service_worker": "background.js", "scripts": ["page.js", "background.js"] },
  "browser_specific_settings": { "gecko": { "id": "browser-bridge@inkstone.app", "strict_min_version": "128.0" } }
}
