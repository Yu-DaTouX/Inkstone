{
  "name": "yan-desktop",
  "version": "0.9.4",
  "description": "砚 · 独立 agent 桌面端（pi 作内核）",
  "main": "./out/main/index.js",
  "author": "Yu-DaTouX",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yu-DaTouX/Inkstone.git"
  },
  "homepage": "https://github.com/Yu-DaTouX/Inkstone#readme",
  "bugs": {
    "url": "https://github.com/Yu-DaTouX/Inkstone/issues"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
    "pi",
    "electron",
    "desktop",
    "react",
    "typescript",
    "rpc",
    "chat"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "tokens:v3": "node scripts/design/build-tokens.mjs",
    "check:tokens:v3": "node scripts/design/build-tokens.mjs --check && node scripts/design/check-v3-contrast.mjs",
    "check:styles:v3": "node scripts/test-v3-style-isolation.mjs && node scripts/design/check-v3-style-isolation.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:stories": "node scripts/test-v3-story-coverage.mjs",
    "test:v3-ui-exports": "node scripts/test-v3-ui-exports.mjs",
    "start": "node scripts/launch.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && node scripts/lint-css.mjs && npm run lint:layers",
    "icons": "node scripts/design/icons/build-icons.mjs",
    "probe-pi": "npm run build && node scripts/probe-pi.mjs",
    "shot": "electron scripts/shot.mjs",
    "test:live": "node scripts/test-live.mjs",
    "check": "npm run typecheck && npm run check:shell-icons && npm run check:icons && npm run build && npm run test:unit && npm run test:skill-source && npm run vendor:pi:check -- --if-present && npm run measure:design && npm run test:live -- live sound hotkeys browserframes pending working queuestack deltas fileref modelswitch sessionlayout runnerselect",
    "test:unit": "node scripts/test-unit.mjs",
    "test:checkpoints": "node scripts/test-checkpoints.mjs",
    "test:agent-native-context": "node scripts/test-agent-native-context.mjs",
    "test:relay": "node scripts/test-relay-bridge.mjs && node scripts/test-relay-mobile.mjs",
    "test:skill-files": "node scripts/test-skill-files.mjs && node scripts/test-acquired-skills.mjs",
    "test:skill-source": "node scripts/test-skill-source.mjs",
    "audit:project": "node scripts/audit/project.cjs",
    "audit:refs": "node scripts/audit/deep.cjs",
    "audit:repros": "node scripts/audit/repros.cjs",
    "lint:css": "node scripts/lint-css.mjs",
    "lint:layers": "node scripts/css-layer-check.mjs --selftest",
    "measure:design": "electron scripts/design/measure-design.mjs",
    "vendor:pi": "node scripts/vendor-pi.mjs",
    "vendor:pi:check": "node scripts/vendor-pi.mjs --check",
    "upgrade:pi": "node scripts/upgrade-pi.mjs",
    "probe:chrome": "node scripts/probe/chrome-cdp.mjs",
    "launch": "node scripts/launch.mjs",
    "launch:dev": "node scripts/launch.mjs --dev",
    "control": "node scripts/yan-control.mjs --server",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:portable-fast": "npm run build && electron-builder --win zip --publish never",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:upgrade": "node scripts/test-upgrade-read.mjs",
    "dist:check": "npm run dist:dir && npm run test:packaged",
    "icon": "electron scripts/build-icon.mjs",
    "check:brand": "electron scripts/build-icon.mjs --check",
    "test:brand": "node scripts/test-brand-assets.mjs && node scripts/test-v3-tray-animation.mjs",
    "installer:sidebar": "electron scripts/build-installer-sidebar.mjs",
    "check:shell-icons": "node scripts/check-shell-icons.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "probe:search": "node scripts/probe/search.mjs",
    "report:i18n": "node scripts/report-unused-i18n.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "storybook": "^10.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mogeko/maple-mono-cn": "^7.9.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.57.0",
    "mermaid": "11.17.2",
    "node-pty": "^1.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tar": "7.5.22",
    "virtua": "^0.51.2",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
