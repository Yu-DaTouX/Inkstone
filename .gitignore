# ---- 本地备份（.backup/<时间戳>/ 是手动快照，不入库）----
.backup/

# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
dist/
out/
build/*
!build/icon.ico
!build/icon.png
!build/prompt-stone.svg
!build/installerSidebar.bmp
!build/installer-sidebar-generated.png
!build/installerHeader.bmp
!build/installer-header-generated.png
!build/installer.nsh
!build/installer-anim/
!build/installer-anim/*.bmp
release/
*.tsbuildinfo

# ---- 本机 pi 包引用（.pi/settings.json 写的是这台机器的绝对路径）----
.pi/

# ---- 字体全量文件（体积大、可从公开源重新获取）----
*.ttf
*.otf
*.woff
*.woff2
*.tgz

# ---- 临时 / 日志 ----
*.log
npm-debug.log*
.tmp/
.codegraph/
.archify/
/* 一次性调试脚本（`.tmp-diag.mjs` 这类）——文件名带前缀，不是目录 */
.tmp-*
temp/
/* 砚本机能力的请求 / 回执文件（`yan question ask` / `goal report` / 子代理请求等） */
.yan-tmp/

# ---- 编辑器 / 系统 ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 密钥（pi 的 auth.json 之类，永不入库）----
auth.json
*.key
.env
.env.*

# ---- 内置 pi 运行时（20MB，由 `npm run vendor:pi` 从本地已装 pi 生成，不入库）----
resources/pi-runtime/
resources/search-tools/

# ---- 一次性审计工具的中间产物（脚本本身纳管，见scripts/audit/）----
.audit-*.json

# Local task reports and one-off request files
/goal-plan.json
/tmp-image-capability-query.json
/nul

# Internal planning and evidence remain local
/.local-docs/
/docs/

# 手机端（mobile/）：依赖与原生构建产物不入库
/mobile/node_modules/
/mobile/android/app/src/main/assets/inkstone-terminal/
/mobile/android/app/build/
/mobile/android/build/
/mobile/android/.gradle/
/mobile/android/.kotlin/
/mobile/android/app/.cxx/
/mobile/android/.idea/
/mobile/android/local.properties
/mobile/*.keystore

# Codex 远程会话的临时附件
/.codex-remote-attachments/

# Python 字节码（Hermes 插件本地运行产生）
__pycache__/
*.pyc

# 本机个人文件（不属于项目）
/.claude/
/ai-quota/
/scratchpad_*.mjs
/*.lnk
/artifacts/
