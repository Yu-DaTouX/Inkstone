# ---- 本地备份（.backup/<时间戳>/ 是手动快照，不入库）----
.backup/

# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
dist/
out/
build/*
!build/icon.ico
!build/icon.png
release/
*.tsbuildinfo

# 录屏中间帧；保留最终 GIF 与审阅截图
docs/design/preview/live/frame-*.png

# ---- 字体全量文件（体积大、可从公开源重新获取，见 docs/design/font-test/README.md）----
*.ttf
*.otf
*.woff
*.woff2
*.tgz

# ---- 临时 / 日志 ----
*.log
npm-debug.log*
.tmp/
temp/

# ---- 编辑器 / 系统 ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 密钥（pi 的 auth.json 之类，永不入库）----
auth.json
*.key
.env
.env.*

# ---- 内置 pi 运行时（20MB，由 `npm run vendor:pi` 从本地已装 pi 生成，不入库）----
resources/pi-runtime/

# ---- 一次性审计工具的中间产物（脚本本身纳管，见仓库根目录 .audit-*.cjs）----
.audit-*.json
