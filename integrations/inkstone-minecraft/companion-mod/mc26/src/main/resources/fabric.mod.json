		"client": ["dev.inkstone.companion.InkstoneCompanion"]
	},
	"mixins": ["inkstone-companion-mc26.mixins.json"],
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": ">=26.1 <26.2"
	}
}
